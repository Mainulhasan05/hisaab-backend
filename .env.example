# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hisaabDB?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Session lifetimes, in DAYS. One number per audience; both the JWT expiry and
# the cookie maxAge are derived from it (see config/constants.js), so they can
# never drift apart. Admin is the platform console — shorten it if you want a
# tighter blast radius on a laptop left open (ADMIN_SESSION_DAYS=1).
ADMIN_SESSION_DAYS=7
USER_SESSION_DAYS=7

JWT_EXPIRES_IN=30d
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=30d

# MimSMS
MIMSMS_USERNAME=your-mimsms-username
MIMSMS_API_KEY=your-mimsms-api-key
MIMSMS_SENDER_ID=your-sender-id

# TransactionType is a property of the ENDPOINT, not of the message. Probed
# against a live account: /SMS takes T|P|D, /OneToMany takes T ONLY, /DSMS takes
# D ONLY. Anything else comes back "Invalid TransactionType" — as HTTP 200, with
# the refusal in the body. Only override these if your account is provisioned
# differently, and re-probe before you do.
# MIMSMS_TXN_TYPE_SINGLE=T
# MIMSMS_TXN_TYPE_BULK=T
# MIMSMS_TXN_TYPE_DYNAMIC=D

# ── Automas (failover gateway) ──────────────────────────────────────────────
# A gateway with no credentials reports itself unconfigured and is EXCLUDED from
# failover selection rather than failing on every message — so leaving these
# blank is safe, it simply means there is no backup.
AUTOMAS_API_KEY=your-automas-api-key
AUTOMAS_SENDER_ID=your-approved-sender-id

# The published docs use ONE url for every operation, distinguished only by the
# body shape, and never state the balance path. Override per path if your
# account's documentation differs — that way a doc discrepancy is a config
# change rather than a patch.
# AUTOMAS_BASE_URL=https://api.automas.com.bd/smsapiv3
# AUTOMAS_PATH_SINGLE=
# AUTOMAS_PATH_BULK=
# AUTOMAS_PATH_DYNAMIC=
# AUTOMAS_PATH_BALANCE=

# Automas documents its message field as "HTTP encoded", meaning it URL-decodes
# the body server-side. A literal %, &, + or # is otherwise either corrupted or
# — worse — accepted with a success id and silently never delivered.
#
# VERIFY THIS ONCE against a real send containing an "&". If the recipient reads
# a literal "%26", this is over-encoding and should be switched off.
# AUTOMAS_HTTP_ENCODE=false

# ── Gateway routing ─────────────────────────────────────────────────────────
# The floor beneath the admin panel's setting (Admin → SMS Gateways), which
# overrides these. Env answers before the database is read, and answers if the
# stored setting names a provider that no longer exists.
# SMS_DEFAULT_PROVIDER=mimsms
# SMS_FAILOVER_ENABLED=false

# How long a routing/pricing lookup may hold up a send before the platform
# default is used instead. Mongoose BUFFERS rather than failing fast when the
# database is unreachable, so without this bound an outage in a collection that
# only decides which gateway to use would add ~10s to every message.
# SMS_LOOKUP_TIMEOUT_MS=2000
# SMS_ROUTING_CACHE_MS=30000
# SMS_RATE_CACHE_MS=60000

# What platform broadcasts sign off as (admin panel → Broadcast).
PLATFORM_SMS_SENDER_NAME=Hisaab

# ── SMS campaign queue (BullMQ) ─────────────────────────────────────────────
# Campaigns above SMS_BULK_SYNC_LIMIT run through a durable queue on the same
# Redis as the cache. REQUIRES USE_REDIS=true — with Redis down, large sends are
# REFUSED rather than run in-process, because an in-process campaign dies on
# every `pm2 reload`. Small sends finish inside the request and are unaffected.
#
# Redis must be maxmemory-policy=noeviction, or a busy cache can evict a queued
# campaign. Verify with: node scripts/verify-sms-queue.js
# USE_SMS_QUEUE=false          # switch queued sends off without touching the cache
# SMS_QUEUE_CONCURRENCY=1      # raise only if MimSMS tolerates parallel campaigns
# SMS_QUEUE_LOCK_MS=300000     # must exceed the longest single campaign run
# SHUTDOWN_GRACE_MS=11000      # must stay under PM2 kill_timeout (12000)

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://hisaab.bd

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=5

# Redis (for caching, online tracking, session)
USE_REDIS=true

# Option 1: Unix Socket (for shared hosting - cPanel, DirectAdmin, stackroo, etc.)
# REDIS_SOCKET=/home/username/.redis/redis.sock

# Option 2: TCP Connection (for VPS/Redis Cloud)
# REDIS_HOST=your-redis-host.cloud.redislabs.com
# REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=your-redis-password

# Note: If both REDIS_SOCKET and REDIS_HOST are set, socket takes priority
# If neither is set and USE_REDIS=true, falls back to in-memory cache

# ImgBB Configuration
IMGBB_API_KEY=your_official_imgbb_api_key
IMGBB_UPLOAD_TIMEOUT_MS=180000


# Meta Conversions API (server-side twin of the browser Pixel)
# Token MUST come from: Events Manager > your Pixel > Settings > Conversions API
# > "Generate access token" (needs ads_management). A Diagnostics-tab token
# with only read_ads_dataset_quality will NOT work.
META_PIXEL_ID=2231977420978675
META_CAPI_ACCESS_TOKEN=EAAivJU4avZC8BSMFm9jyqBVKBRqwogSkHTdTg6laYqVjoh4Vq83MxL8cUhlcr7I23pGcECVxeTmQZAkcWeJgEACmrfECaPGfICLomSSAKaY7sFq9UarjRKDtBUbzebK5PMFhL0UdBIaduCRIACeSByXP7ThdnnGgQ4OoeMHvk58rhMEPQwaIIfUTI12aRBQwZDZD
META_GRAPH_VERSION=v23.0
META_CAPI_TIMEOUT_MS=5000
# Set only while validating in Events Manager > Test Events, then remove
# META_TEST_EVENT_CODE=TEST12345


# Telegram — daily sales digest to shop owners
#
# Entirely optional. With TELEGRAM_BOT_TOKEN unset the bot never starts, the
# digest job no-ops on every tick, and the rest of the app is unaffected.
#
# Get the token from @BotFather in Telegram: /newbot, then copy the line that
# looks like 8123456789:AAH... — it is the bot's password, treat it as a secret.
#
# IMPORTANT: only ONE process may run with this token. Telegram allows a single
# polling consumer per bot, so a local dev server and production sharing one
# token will steal each other's /start messages and linking will appear broken.
# Use a second bot from @BotFather for development.
TELEGRAM_BOT_TOKEN=

# Optional. The bot's @username is read from Telegram at startup; this is only
# a fallback for building t.me deep links if that call is ever unavailable.
# Enter it without the leading @.
TELEGRAM_BOT_USERNAME=

# ── Platform owner alerts ───────────────────────────────────────────────────
#
# The SAME bot token above also drives the operator's own channel: new shop
# signups, user logins, security events and a daily platform report. Nothing
# extra to configure — a platform admin links their Telegram from the console
# (Alerts page) and the bot recognises the deep link as an admin one.
#
# Where SMS codes for ADMIN password changes are sent. This is a two-person
# control on purpose: whichever admin asks, the code goes here, so nobody
# re-cuts a key to the platform without the founder's phone in hand.
#
# Falls back to SUPER_ADMIN_PHONE and then to the seeded founder number, so an
# existing deployment keeps working with this unset. Set it explicitly in
# production — leaving it implicit means the destination changes silently if
# SUPER_ADMIN_PHONE is ever edited.
PLATFORM_FOUNDER_PHONE=01757995016

# ── R2 image storage ────────────────────────────────────────────────────────
#
# AES-256-GCM key encrypting R2Account secret access keys at rest. 64 hex
# characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Unset = the admin panel refuses to add a bucket at all, rather than storing
# a credential in plaintext. Nothing else degrades: shops without storage are
# unaffected, since `storage.enabled` is off for them anyway.
#
# NOT derived from JWT_SECRET on purpose — rotating a JWT secret is routine and
# must not silently brick storage. Changing THIS value makes every stored R2
# credential undecryptable; they must be re-entered from the Cloudflare
# dashboard. Treat it as a backup-critical secret.
STORAGE_ENC_KEY=

# ── PayStation (platform billing gateway) ───────────────────────────────────
#
# Self-serve subscription renewal and SMS top-up. Leave PAYSTATION_MERCHANT_ID
# blank and the whole feature stays off: the owner's billing page falls back to
# the "call us" card, every checkout endpoint refuses, and billing carries on
# being keyed in by an admin exactly as before.
#
# HALF-CONFIGURED IS FATAL AT BOOT (config/env.js). Setting the merchant id
# without the password or the two public URLs would let a shop be charged by the
# bank and get nothing back, which is unrecoverable from their side.
#
# The switch that actually shows the buttons is PlatformSetting.billingProvider
# in the admin console — credentials here are necessary but not sufficient, so
# you can deploy the config first and turn the feature on afterwards.
PAYSTATION_ENV=sandbox
PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=

# Externally reachable ORIGINS — PayStation resolves the first from the public
# internet, and the second is where a paying customer's browser is sent back to.
# A localhost value in production means every payment succeeds at the bank and
# lands nowhere.
API_PUBLIC_URL=https://api.hisaabbd.com
APP_PUBLIC_URL=https://app.hisaabbd.com

# Optional. Overrides the host derived from PAYSTATION_ENV
# (sandbox.paystation.com.bd / api.paystation.com.bd).
# PAYSTATION_BASE_URL=

# 15s rather than the SMS side's 10s: this is a payment session being created
# while a shopkeeper watches a spinner, and giving up early on a slow-but-alive
# gateway burns an invoice number for nothing.
# PAYSTATION_HTTP_TIMEOUT_MS=15000

# Dev seam, mirroring SKIP_SMS. Pretends every initiate succeeds and every
# lookup comes back paid, so the whole flow can be exercised without money.
# NEVER set this anywhere real — it grants subscriptions for free.
# SKIP_PAYMENTS=false

# How often the reconciliation sweep asks the gateway about checkouts nobody
# told us about. This is not a backstop: with no server-side IPN, it is the only
# thing that serves a customer who paid in the bKash app and never came back to
# the browser. Raising it raises how long such a shop waits for what it bought.
# PAYMENT_RECONCILE_INTERVAL_MS=300000

# Per-SHOP ceiling on opening gateway sessions, and per-IP on the return
# redirect. Both deliberately generous — a false 429 here strands somebody who
# has already been charged.
# CHECKOUT_RATE_LIMIT_MAX=12
# PAYMENT_RETURN_RATE_LIMIT_MAX=60

# How long a paying customer's browser is held while we confirm with the gateway
# before being redirected anyway. There is a real person watching a blank tab
# here, seconds after their money left their wallet — and the unbounded worst
# case (a slow gateway plus a stalled database) is around 25 seconds of nothing,
# which reads as a failed payment and produces a second one. Raising this trades
# that risk for more instant confirmations.
# PAYMENT_RETURN_BUDGET_MS=8000
